# Copy to .env.local and adjust for your environment.
# The FastAPI backend (Flagger_app) has no host/port override configured,
# so it runs on uvicorn's default of http://127.0.0.1:8000 in local dev.
# Read server-side by next.config.ts's rewrites() to proxy /api/* to the
# real backend — the browser itself never calls this URL directly anymore
# (see src/lib/api/client.ts). That's what makes the backend's httpOnly
# access_token cookie first-party instead of cross-site; still NEXT_PUBLIC_
# only because nothing currently depends on it staying private, not because
# client code reads it.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Support contact shown on "Talk to Admin" (Call + WhatsApp) — digits only,
# no "+" (the format wa.me/tel: links expect). Display formatting is
# derived from this in src/lib/constants.ts.
NEXT_PUBLIC_ADMIN_WHATSAPP=26662338327
